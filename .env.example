# Django
DEBUG=true
SECRET_KEY=django-insecure-local-development-only-change-me
TIME_ZONE=Asia/Tehran
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
SECURE_SSL_REDIRECT=false

# PostgreSQL
DB_NAME=cdr
DB_USER=cdr
DB_PASSWORD=cdr-local-development-only-change-me
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_RESULT_BACKEND=redis://redis:6379/1

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=cdr
RABBITMQ_PASSWORD=cdr-local-development-only-change-me
RABBITMQ_VHOST=cdr
CELERY_BROKER_URL=amqp://cdr:cdr-local-development-only-change-me@rabbitmq:5672/cdr

# Elasticsearch
ELASTICSEARCH_HOST=http://elasticsearch:9200

# Application
API_LOG_LEVEL=INFO
API_WORKERS=2
API_THREADS=4
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_HOST_PORT=8082
SECURE_HSTS_PRELOAD=false
